# ============================================================
# GolfMe — Strict .gitignore
# Covers: Node/React toolchain, build outputs, secrets, caches,
# OS cruft, and IDE artifacts. Keeps the repository clean and
# guarantees no environment-specific state is ever committed.
# ============================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build outputs ---
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# --- Environment & secrets (never commit real values) ---
.env
.env.*
!.env.example

# --- Caches ---
.cache/
.turbo/
.eslintcache
.npm/
.pnpm-store/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# --- IDE / editor ---
.vscode/
.idea/
*.suo
*.sublime-project
*.sublime-workspace

# --- Hermes local plans (never part of the deliverable) ---
.hermes/
